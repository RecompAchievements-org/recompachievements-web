# Server-only settings for the website (never prefixed with NEXT_PUBLIC_, never sent to browsers).
# Copy to .env.local for local development; set the real values in the hosting dashboard.

# Base URL of the RecompAchievements API (backend/). Local: http://localhost:5080
API_BASE_URL=http://localhost:5080

# Shared secret the API requires on website-only endpoints. Must match the API's InternalApi__Key.
# Local default matches backend/src/RecompAchievements.Api/appsettings.Development.json.
API_INTERNAL_KEY=local-development-internal-key
