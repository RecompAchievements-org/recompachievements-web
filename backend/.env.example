# Environment variables read by the API. Copy the names into your host's settings; never commit
# real values. Local development uses appsettings.Development.json and docker-compose.yml instead.

# PostgreSQL connection string (Npgsql format).
ConnectionStrings__Database=Host=localhost;Port=5432;Database=recompachievements;Username=recomp;Password=change-me

# "Production" on hosted environments.
ASPNETCORE_ENVIRONMENT=Production

# Port the API listens on inside the container.
ASPNETCORE_HTTP_PORTS=8080

# Set to true only when the API is reachable exclusively through the host's proxy.
ForwardedHeaders__TrustAllProxies=false

# Apply pending EF Core migrations when the API starts.
Database__ApplyMigrationsOnStartup=true

# Import the curated game catalog (Catalog/Games/*.json) when the API starts, after migrations.
Catalog__ImportOnStartup=true

# Shared secret between the website and the API (generate with: openssl rand -base64 32).
InternalApi__Key=change-me

# Transactional email API key (required outside Development).
Brevo__ApiKey=change-me

# Discord and GitHub sign-in (optional). Each platform is offered only when both of its values are
# set; register {Site__BaseUrl}/auth/callback/discord (or /github) as the app's redirect URL.
Discord__ClientId=
Discord__ClientSecret=
GitHub__ClientId=
GitHub__ClientSecret=

# SteamGridDB API key (optional). With it, catalog games without art get it picked once after
# startup; leave empty to turn that off.
SteamGridDb__ApiKey=

# When the alpha phase ends (ISO 8601, e.g. 2027-06-01T00:00:00Z). Empty while the alpha runs; every
# account created before this date is an alpha tester.
AlphaPhase__EndsAt=

# Migrate confirmed alpha list sign-ups to accounts and email each a set-password link (one-time;
# safe to leave on once done). DryRun only logs what it would do.
AlphaMigration__Enabled=false
AlphaMigration__DryRun=false

# Profile photo storage (S3-compatible bucket behind a CDN). Without a bucket, Development keeps files
# in an ignored local folder and other environments turn uploads off. With a bucket outside
# Development, the purge values are required so removed images leave the CDN.
MediaStorage__BucketName=
MediaStorage__ServiceUrl=
MediaStorage__AccessKey=
MediaStorage__SecretKey=
MediaStorage__PublicBaseUrl=
MediaStorage__PurgeUrl=
MediaStorage__PurgeToken=
# Private bucket for evidence preserved under a legal hold; never public.
MediaStorage__EvidenceBucketName=

# Sender of outgoing email and the website address used in email links.
Email__FromAddress=contact@recompachievements.org
Email__FromName=RecompAchievements
Site__BaseUrl=https://recompachievements.org
