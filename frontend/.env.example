# Settings for the website. Only NEXT_PUBLIC_ values reach the browser; everything else is server-only.
# Copy to .env.local for local development; set the real values in the hosting dashboard.

# Base URL of the RecompAchievements API (backend/). Local: http://localhost:5080
API_BASE_URL=http://localhost:5080

# Shared secret the API requires on website-only endpoints. Must match the API's InternalApi__Key.
# Local default matches backend/src/RecompAchievements.Api/appsettings.Development.json.
API_INTERNAL_KEY=local-development-internal-key

# Human-verification challenge on the alpha sign-up form. The values below are the provider's
# official TEST keys (always pass) for local development and preview deployments; production uses
# real keys set in the hosting dashboard. The site key is public by design; the secret is not.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
